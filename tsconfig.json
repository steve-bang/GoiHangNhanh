{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "firebase-admin/*": ["./firebase/functions/node_modules/firebase-admin/lib/*"]
    }
  },
  "include": [
    "jest.setup.ts",
    "src",
    "firebase/tests",
    "firebase/functions/src",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "dist", "coverage"]
}
