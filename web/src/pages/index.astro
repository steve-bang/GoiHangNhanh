---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Features from '../components/sections/Features.astro';
import Audience from '../components/sections/Audience.astro';
import Steps from '../components/sections/Steps.astro';
import FaqSection from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { site } from '../config/site';
import { faqLd, organizationLd, websiteLd, type Faq } from '../lib/jsonld';

// Title ~50-60 ký tự, description ~120-160 ký tự (kiểm bằng `npm run check:seo`).
const title = `${site.name}: lưu bằng chứng đóng hàng cho shop online`;
const description =
  'Quay đóng gói, gắn đúng đơn, tìm lại theo mã đơn khi khách báo thiếu hàng hoặc hàng hoàn có vấn đề. Ứng dụng đang phát triển, chưa phát hành.';

// NỘI DUNG GIỮ CHỖ chờ duyệt: câu hỏi dưới đây là bản nháp, chưa phải câu hỏi thật từ người bán.
// Mọi tính năng ghi hình/tải lên hôm nay đều "sắp có" (xem CLAUDE.md, mục Trạng thái dự án).
const faqs: Faq[] = [
  {
    question: `${site.name} là gì?`,
    answer: `${site.name} là ứng dụng điện thoại giúp người bán online quay video đóng hàng, gắn đúng đơn và tìm lại theo mã đơn. Ứng dụng đang phát triển và chưa phát hành.`,
  },
  {
    question: 'Có chắc thắng khiếu nại không?',
    answer: `Không. ${site.name} giúp bạn lưu và tìm lại video có tổ chức. Sàn và đơn vị vận chuyển mới là bên quyết định. Chúng tôi không hứa kết quả khiếu nại.`,
  },
  {
    question: 'Giá và thời hạn lưu video là bao nhiêu?',
    answer:
      'Chưa công bố. Gói dịch vụ và thời hạn lưu chưa chốt. Khi có, chúng tôi sẽ ghi rõ trên trang này và trong ứng dụng.',
  },
  {
    question: 'Có phải mở sàn Shopee hay TikTok Shop để dùng không?',
    answer:
      'Không. Bạn tự nhập hoặc quét mã đơn. Ứng dụng không cần kết nối với sàn để bắt đầu.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={[organizationLd(), websiteLd(), faqLd(faqs)]}
>
  <Hero />
  <WhyUs />
  <Features />
  <Audience />
  <Steps />
  <FaqSection faqs={faqs} />
  <FinalCta />
</BaseLayout>
