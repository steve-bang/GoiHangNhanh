---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`Không tìm thấy trang | ${site.name}`}
  description={`Trang bạn tìm không còn hoặc đã đổi địa chỉ. Quay về trang chủ ${site.name} để xem thông tin mới nhất.`}
  path="/404/"
  noindex
  noCanonical
>
  <section class="section">
    <div class="container">
      <h1>Không tìm thấy trang này</h1>
      <p>Địa chỉ có thể đã gõ sai hoặc trang đã được dời đi.</p>
      <p><a class="btn" href="/">Về trang chủ</a></p>
      <p>Hoặc xem <a href="/#cau-hoi">câu hỏi thường gặp</a>.</p>
    </div>
  </section>
</BaseLayout>
