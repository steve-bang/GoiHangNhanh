---
import Icon from '../Icon.astro';
import DownloadCta from '../DownloadCta.astro';
---

<section id="tai-ung-dung" class="final" aria-labelledby="cta-cuoi">
  <div class="container">
    <div class="final__panel">
      <div>
        <h2 id="cta-cuoi">Muốn biết khi ứng dụng ra mắt?</h2>
        <p>Chưa có liên kết tải. Khi phát hành, nút tải sẽ hiện ở đây.</p>
        <DownloadCta />
      </div>
      <div class="final__visual" aria-hidden="true">
        <span class="hand">Mỗi đơn, một video riêng.</span>
        <Icon name="shield" size={48} />
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    padding-block: var(--space-16) var(--space-48);
  }
  .final__panel {
    display: grid;
    gap: var(--space-24);
    padding: var(--space-24) var(--space-16);
    border-radius: var(--radius-24);
    background: linear-gradient(135deg, var(--brand-soft), var(--mint-200));
  }
  p {
    color: var(--text-secondary);
  }
  .final__visual {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    color: var(--action-primary);
  }
  .hand {
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-16);
    background: var(--surface-raised);
    font-family: var(--font-hand);
    font-style: italic;
    font-size: var(--text-lg);
    transform: rotate(-3deg);
  }
  @media (min-width: 60rem) {
    .final__panel {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: var(--space-48);
    }
    .final__visual {
      justify-content: center;
    }
  }
</style>
