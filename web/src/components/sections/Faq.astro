---
import type { Faq } from '../../lib/jsonld';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<section id="cau-hoi" class="faq" aria-labelledby="cau-hoi-tieu-de">
  <div class="container faq__inner">
    <div>
      <h2 id="cau-hoi-tieu-de">Câu hỏi thường gặp</h2>
      {
        faqs.map((f) => (
          <div class="faq__item">
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </div>
        ))
      }
    </div>

    <aside class="honest" aria-labelledby="khong-hua">
      <h3 id="khong-hua">Điều chúng tôi không hứa</h3>
      <ul>
        <li>Không hứa thắng khiếu nại hay tranh chấp.</li>
        <li>Không nói video là "bằng chứng pháp lý tuyệt đối".</li>
        <li>
          Tải lên chạy nền nhưng điện thoại có thể tạm dừng khi hết pin hoặc mất mạng. Ứng dụng sẽ
          báo rõ video nào chưa tải xong.
        </li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-32);
  }
  .faq__inner {
    display: grid;
    gap: var(--space-24);
  }
  .faq__item {
    margin-bottom: var(--space-16);
    padding: var(--space-16);
    border-radius: var(--radius-16);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }
  .faq__item h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }
  .faq__item p {
    margin: 0;
    color: var(--text-secondary);
  }
  .honest {
    align-self: start;
    padding: var(--space-24) var(--space-16);
    border-radius: var(--radius-24);
    background: var(--feedback-warning-bg);
    border: var(--border-thin) solid var(--feedback-warning-fg);
  }
  .honest h3 {
    color: var(--brand-dark);
  }
  .honest ul {
    margin: 0;
    padding-left: var(--space-24);
  }
  @media (min-width: 60rem) {
    .faq {
      padding-block: var(--space-48);
    }
    .faq__inner {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-48);
    }
    .honest {
      padding: var(--space-32);
    }
  }
</style>
