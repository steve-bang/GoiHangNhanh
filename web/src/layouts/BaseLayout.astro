---
import '../styles/global.css';
import { site } from '../config/site';
import NavMenu from '../components/NavMenu.astro';
import DownloadCta from '../components/DownloadCta.astro';
import { navLinks } from '../config/nav';
import { absoluteUrl, serializeLd, type JsonLd } from '../lib/jsonld';

interface Props {
  /** Tiêu đề đầy đủ (~50-60 ký tự), duy nhất mỗi trang. */
  title: string;
  /** Mô tả (~120-160 ký tự), duy nhất mỗi trang. */
  description: string;
  /** Đường dẫn của trang, bắt đầu và kết thúc bằng "/". Dùng cho canonical. */
  path: string;
  /** Ảnh chia sẻ 1200x630, đường dẫn trong public/. */
  ogImage?: string;
  /** Ép noindex (trang nháp, 404). Khi site.indexable=false thì mọi trang đều noindex. */
  noindex?: boolean;
  /** Không in canonical (trang 404). */
  noCanonical?: boolean;
  jsonLd?: JsonLd[];
}

const {
  title,
  description,
  path,
  ogImage = site.ogImage,
  noindex = false,
  noCanonical = false,
  jsonLd = [],
} = Astro.props;

const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage);
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#157852" />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={serializeLd(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
    <NavMenu current={Astro.url.pathname} />
    <main id="noi-dung">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__name">
            <img src="/favicon.png" alt="" width="32" height="32" />
            <strong>{site.name}</strong>
          </p>
          <p>{site.tagline}</p>
        </div>
        <nav aria-label="Chân trang">
          <ul>
            {
              navLinks.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-footer__cta"><DownloadCta tone="dark" compact label="Sắp có trên App Store và Google Play" /></div>
      </div>
      <div class="container site-footer__legal">
        <p>
          <strong>{site.name}</strong> là tên làm việc. Ứng dụng đang phát triển, chưa phát hành.
        </p>
        <p>
          Chúng tôi không hứa kết quả khiếu nại và không phải dịch vụ pháp lý. Trang này chưa có
          chính sách quyền riêng tư và điều khoản; sẽ bổ sung trước khi phát hành.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer {
    background: var(--brand-dark);
    color: var(--text-on-action);
    padding-block: var(--space-32);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: var(--text-on-action);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-24);
    padding-bottom: var(--space-24);
    border-bottom: var(--border-thin) solid rgb(255 255 255 / 0.2);
  }
  .site-footer__name {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }
  .site-footer__brand p:last-child {
    margin: 0;
    color: var(--mint-200);
  }
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-16);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    text-decoration: none;
  }
  .site-footer__legal {
    padding-top: var(--space-16);
    color: var(--mint-200);
  }
  .site-footer__legal p {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }
  @media (min-width: 60rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: var(--space-32);
    }
  }
</style>
